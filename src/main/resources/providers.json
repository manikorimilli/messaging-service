{
  "messaging": {
    "http-providers": {
      "twilio": {
        "id": "TWILIO",
        "display-name": "Twilio",
        "channels": [
          "SMS"
        ],
        "variables": {
          "account-sid": "${TWILIO_ACCOUNT_SID:}",
          "api-key": "${TWILIO_API_KEY:}",
          "api-secret": "${TWILIO_API_SECRET:}",
          "from": "${TWILIO_SMS_FROM:}"
        },
        "request": {
          "method": "POST",
          "url": "https://api.twilio.com/2010-04-01/Accounts/{{account-sid}}/Messages.json",
          "auth": {
            "type": "basic",
            "username": "{{api-key}}",
            "password": "{{api-secret}}"
          },
          "body": {
            "format": "form",
            "fields": {
              "To": "{{to}}",
              "From": "{{from}}",
              "Body": "{{text}}"
            }
          }
        },
        "response": {
          "success": {
            "http-status": [
              "2xx"
            ]
          },
          "id-path": "$.sid",
          "status-path": "$.status",
          "error": {
            "code-path": "$.code",
            "message-path": "$.message"
          },
          "retry": {
            "http-status": [
              "429",
              "5xx"
            ]
          }
        }
      },
      "vonage": {
        "id": "VONAGE",
        "display-name": "Vonage",
        "channels": [
          "SMS"
        ],
        "variables": {
          "api-key": "${VONAGE_API_KEY:}",
          "api-secret": "${VONAGE_API_SECRET:}",
          "from": "${VONAGE_SMS_FROM:}"
        },
        "request": {
          "method": "POST",
          "url": "https://rest.nexmo.com/sms/json",
          "auth": {
            "type": "basic",
            "username": "{{api-key}}",
            "password": "{{api-secret}}"
          },
          "body": {
            "format": "form",
            "fields": {
              "from": "{{from}}",
              "to": "{{to_digits}}",
              "text": "{{text}}"
            },
            "unicode-fields": {
              "type": "unicode"
            }
          }
        },
        "response": {
          "success": {
            "http-status": [
              "200"
            ],
            "each": "$.messages",
            "field": "status",
            "expected": "0"
          },
          "id-path": "$.messages[0].message-id",
          "status-path": "$.messages[0].status",
          "error": {
            "code-path": "$.messages[?(@.status != '0')].status",
            "message-path": "$.messages[?(@.status != '0')].error-text"
          },
          "retry": {
            "http-status": [
              "429",
              "5xx"
            ],
            "codes": [
              "1",
              "5"
            ]
          }
        }
      }
    }
  }
}
