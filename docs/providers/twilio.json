{
  "id": "TWILIO",
  "display-name": "Twilio",
  "channels": [
    "SMS"
  ],
  "enabled": true,
  "variables": {
    "account-sid": "",
    "api-key": "",
    "api-secret": "",
    "from": ""
  },
  "request": {
    "method": "POST",
    "url": "https://api.twilio.com/2010-04-01/Accounts/{{account-sid}}/Messages.json",
    "auth": {
      "type": "basic",
      "username": "{{api-key}}",
      "password": "{{api-secret}}"
    },
    "body": {
      "format": "form",
      "fields": {
        "To": "{{to}}",
        "From": "{{from}}",
        "Body": "{{text}}"
      }
    }
  },
  "response": {
    "success": {
      "http-status": [
        "2xx"
      ]
    },
    "id-path": "$.sid",
    "status-path": "$.status",
    "error": {
      "code-path": "$.code",
      "message-path": "$.message"
    },
    "retry": {
      "http-status": [
        "429",
        "5xx"
      ]
    }
  }
}
