# Optional. Copy this file to .env to set environment variables for local runs.
# .env is git-ignored; never commit it. Real environment variables with the same names win.
#
# Provider keys (Twilio, Vonage, ...) do not go here. Register each provider through
# POST /api/v1/providers or the console's Register provider page; see docs/providers/.
#
# Example: turn on the daily job, which is off by default.
# MESSAGING_BATCHJOB_ENABLED=true
