# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.
# Real environment variables with the same names override these.

# Twilio: Console > Account info (Account SID), Console > API keys & tokens (SK... key and secret)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Your Twilio phone number, e.g. +15551234567
TWILIO_SMS_FROM=

# Vonage: Dashboard > API settings
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Your Vonage number or sender name
VONAGE_SMS_FROM=
